{
	"luci-app-mqtt-switchboard": {
		"description": "Grant access to MQTT Switchboard UCI config and service status",
		"read": {
			"uci": [ "mqtt-switchboard" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/init.d/mqtt-switchboard": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "mqtt-switchboard" ],
			"file": {
				"/etc/init.d/mqtt-switchboard": [ "exec" ]
			}
		}
	}
}
